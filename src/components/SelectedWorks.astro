---
import SectionTitle from './SectionTitle.astro';
import SelectedWorkItem from './SelectedWorkItem.astro';
import ViewToggle from './ViewToggle.astro';
import { getProjectBySlug, FEATURED_SLUGS } from '../data/projects';

const featuredProjects = FEATURED_SLUGS.map((slug) => getProjectBySlug(slug)!);
---

<section class="content-divider flex flex-col items-center px-[16px] md:px-[40px] lg:px-[80px] py-[32px] md:py-[64px] w-full">
  <div class="flex flex-col gap-[32px] items-center max-w-[700px] w-full px-[16px]">
    <!-- Section Title + View Toggle + See All -->
    <div class="flex w-full items-end justify-between gap-[16px]" data-scroll-reveal>
      <SectionTitle title="Selected Works" />

      <div class="flex items-center gap-[16px]">
        <ViewToggle />

        <!-- See All -->
        <a
          href="/works"
          class="nav-link flex items-center gap-[4px] font-mono text-[12px] font-semibold uppercase leading-[16px] text-content-tertiary whitespace-nowrap"
        >
          See all projects
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Grid view (images) -->
    <div data-view-panel="grid" class="flex flex-col gap-[64px] items-start w-full">
      {featuredProjects.map((project) => (
        <div class="w-full" data-scroll-reveal data-view-item><SelectedWorkItem {...project} /></div>
      ))}
    </div>

    <!-- List view (no images) -->
    <div data-view-panel="list" class="hidden flex-col items-start w-full" data-scroll-reveal>
      {featuredProjects.map((project) => (
        <a href={`/works/${project.slug}`} data-view-item class="group flex w-full flex-col gap-[8px] border-b-[0.5px] border-border-secondary py-[16px]">
          <div class="flex items-baseline justify-between gap-[16px] w-full">
            <h3 class="text-[20px] font-semibold leading-[28px] tracking-[-1px] text-content-primary">
              {project.name}
            </h3>
            <span class="shrink-0 font-mono text-[14px] leading-[20px] text-content-tertiary">
              {project.year}
            </span>
          </div>
          <p class="text-[16px] leading-[24px] text-content-secondary">
            {project.title}
          </p>
        </a>
      ))}
    </div>
  </div>
</section>

---
import SectionTitle from './SectionTitle.astro';
import ViewToggle from './ViewToggle.astro';
import ProjectViewPanels from './ProjectViewPanels.astro';
import { getProjectBySlug, FEATURED_SLUGS, type Project } from '../data/projects';

const featuredProjects = FEATURED_SLUGS
  .map((slug) => getProjectBySlug(slug))
  .filter((project): project is Project => project !== undefined);
---

<section class="content-divider flex flex-col items-center px-[16px] md:px-[40px] lg:px-[80px] py-[32px] md:py-[64px] w-full">
  <div class="flex flex-col gap-[32px] items-center max-w-[700px] w-full">
    <!-- Section Title + View Toggle + See All -->
    <div class="flex w-full items-end justify-between gap-[16px]" data-scroll-reveal>
      <SectionTitle title="Selected Works" />

      <div class="flex items-center gap-[16px]">
        <ViewToggle />

        <!-- See All -->
        <a
          href="/works"
          class="nav-link flex items-center gap-[4px] font-mono text-[12px] font-semibold uppercase leading-[16px] text-content-tertiary whitespace-nowrap"
        >
          All projects
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <ProjectViewPanels projects={featuredProjects} />
  </div>
</section>

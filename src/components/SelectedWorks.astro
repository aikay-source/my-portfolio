---
import SectionTitle from './SectionTitle.astro';
import SelectedWorkItem from './SelectedWorkItem.astro';
import { projects } from '../data/projects';
---

<section class="content-divider flex flex-col items-center px-[16px] md:px-[40px] lg:px-[80px] py-[32px] md:py-[64px] w-full">
  <div class="flex flex-col gap-[32px] items-center max-w-[700px] w-full px-[16px]">
    <!-- Section Title -->
    <div class="w-full" data-scroll-reveal>
      <SectionTitle title="Selected Works" />
    </div>

    <div class="flex flex-col gap-[32px] items-start w-full">
      <!-- Project list: single column, 64px gap -->
      <div class="flex flex-col gap-[64px] items-start w-full">
        {projects.map((project) => (
          <div class="w-full" data-scroll-reveal><SelectedWorkItem {...project} /></div>
        ))}
      </div>

      <!-- SEE ALL Button -->
      <a
        href="/works"
        class="btn-hover flex items-center justify-center border border-border-secondary bg-[var(--bg-primary)] p-[12px] self-start"
      >
        <span class="flex items-center justify-center px-[4px]">
          <span class="font-mono text-[14px] font-semibold leading-[20px] text-content-primary">
            SEE ALL
          </span>
        </span>
      </a>
    </div>
  </div>
</section>

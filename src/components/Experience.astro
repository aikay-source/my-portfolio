---
import SectionTitle from './SectionTitle.astro';

const experiences = [
  {
    role: 'Senior Designer',
    company: 'Axiom Growth',
    date: '2025 - Present',
  },
  {
    role: 'Product Designer',
    company: 'Odogwu technologies',
    date: '2023 - 2025',
  },
  {
    role: 'Product Designer',
    company: 'Consode Digital Limited',
    date: '2023 - 2024',
  },
  {
    role: 'Product Design Intern',
    company: 'Hotel.ng',
    date: '2023',
  },
  {
    role: 'Product Design Trainee',
    company: 'Zuri Team, inc.',
    date: '2022',
  },
];
---

<section class="content-divider flex items-center justify-center px-[16px] md:px-[40px] lg:px-[80px] py-[32px] md:py-[64px]">
  <div class="flex flex-col max-w-[700px] w-full items-start gap-[16px]">
    <!-- Section Title (top) -->
    <div data-scroll-reveal>
      <SectionTitle title="Experience" />
    </div>

    <!-- Experience List (below) -->
    <div class="flex w-full md:w-[632px] flex-col gap-[16px]">
      {experiences.map((exp) => (
        <div class="flex flex-col gap-[8px] border-b-[0.5px] border-border-secondary py-[16px]" data-scroll-reveal>
          <div class="flex items-center justify-between w-full gap-[16px]">
            <h3 class="flex-1 text-[14px] font-semibold leading-[20px] text-content-primary">
              {exp.role}
            </h3>
            <span class="shrink-0 font-mono text-[14px] leading-[20px] text-content-tertiary">
              {exp.date}
            </span>
          </div>
          <span class="font-mono text-[14px] leading-[20px] text-content-tertiary">
            {exp.company}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>

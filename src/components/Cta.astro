---
import SectionTitle from './SectionTitle.astro';
import EmailCopyLink from './EmailCopyLink.astro';
---

<section class="section-border flex items-center justify-center px-[16px] md:px-[40px] lg:px-[80px] py-[32px] md:py-[64px]">
  <div class="flex flex-col max-w-[700px] w-full items-start gap-[24px]">
    <!-- Section Title (top) -->
    <div data-scroll-reveal>
      <SectionTitle title="Say Hi" />
    </div>

    <!-- Content (below) -->
    <div class="flex w-full md:w-[632px] flex-col gap-[16px]" data-scroll-reveal>
      <p class="text-[16px] leading-[24px] text-content-secondary">
        I'm always open to hearing about new projects or collaborations.<br />
        Send me a note and I'll get in touch!
      </p>

      <EmailCopyLink email="nwokoloikem@gmail.com" label="Email me at" />
    </div>
  </div>
</section>

---
interface Props {
  name: string;
  title: string;
  image: string;
  tags: string[];
  slug: string;
  imagePosition?: string;
}

const { name, title, image, tags, slug, imagePosition = 'center' } = Astro.props;
---

<a href={`/works/${slug}`} class="flex flex-col gap-[24px] items-start w-full group">
  <!-- Image -->
  <div class="h-[300px] w-full overflow-hidden">
    <img
      src={image}
      alt={name}
      class="size-full object-cover project-card-image"
      style={`object-position: ${imagePosition}`}
      loading="lazy"
    />
  </div>

  <!-- Details -->
  <div class="flex flex-col gap-[16px] items-start w-full">
    <!-- Tag pills -->
    <div class="flex flex-wrap gap-[8px] items-start">
      {tags.map((tag) => (
        <span class="bg-bg-hover px-[8px] py-[4px]">
          <span class="font-mono text-[12px] leading-[16px] text-content-tertiary">
            {tag}
          </span>
        </span>
      ))}
    </div>

    <!-- Name + Description -->
    <div class="flex flex-col items-start w-full">
      <h3 class="text-[20px] font-semibold leading-[28px] tracking-[-1px] text-content-primary">
        {name}
      </h3>
      <p class="text-[16px] leading-[24px] text-content-secondary">
        {title}
      </p>
    </div>
  </div>
</a>

---
interface Props {
  category: string;
  image: string;
}

const { category, image } = Astro.props;
---

<div class="flex flex-col gap-[8px] items-start w-full">
  <div class="h-[272px] md:h-[309px] w-full bg-bg-hover p-[24px] md:p-[32px] flex items-center justify-center overflow-hidden">
    <img
      src={image}
      alt={category}
      class="size-full object-cover"
      loading="lazy"
    />
  </div>
  <span class="w-full text-left uppercase font-mono text-[14px] leading-[20px] text-content-tertiary">
    {category}
  </span>
</div>

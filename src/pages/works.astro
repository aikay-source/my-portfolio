---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import SelectedWorkItem from '../components/SelectedWorkItem.astro';
import { projects } from '../data/projects';
---

<BaseLayout title="Works — Samuel Nwokolo" description="Selected works by Samuel Nwokolo, a product designer focused on usability and delight.">
  <h1 class="sr-only">Works</h1>

  <!-- Selected Works -->
  <section class="section-border flex flex-col items-center px-[16px] md:px-[40px] lg:px-[80px] py-[32px] md:py-[64px]">
    <div class="flex flex-col gap-[32px] items-center max-w-[700px] w-full px-[16px]">
      <div class="w-full" data-scroll-reveal>
        <SectionTitle title="Selected Works" />
      </div>

      <div class="flex flex-col gap-[64px] items-start w-full">
        {projects.map((project) => (
          <div class="w-full" data-scroll-reveal><SelectedWorkItem {...project} /></div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

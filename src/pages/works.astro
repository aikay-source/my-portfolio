---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ViewToggle from '../components/ViewToggle.astro';
import ProjectViewPanels from '../components/ProjectViewPanels.astro';
import { projects } from '../data/projects';

const visibleProjects = projects.filter((project) => !project.archived);
---

<BaseLayout title="Works — Samuel Nwokolo" description="Selected works by Samuel Nwokolo, a product designer focused on usability and delight.">
  <h1 class="sr-only">Works</h1>

  <!-- Selected Works -->
  <section class="section-border flex flex-col items-center px-[16px] md:px-[40px] lg:px-[80px] py-[32px] md:py-[64px]">
    <div class="flex flex-col gap-[32px] items-center max-w-[700px] w-full px-[16px]">
      <!-- Section Title + View Toggle -->
      <div class="flex w-full items-end justify-between gap-[16px]" data-scroll-reveal>
        <SectionTitle title="Selected Works" />
        <ViewToggle />
      </div>

      <ProjectViewPanels projects={visibleProjects} />
    </div>
  </section>
</BaseLayout>

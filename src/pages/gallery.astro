---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import GalleryCard from '../components/GalleryCard.astro';

const galleryItems = [
  { category: 'Product Design', image: '/images/gallery/envoice login screen.png' },
  { category: 'Product Design', image: '/images/gallery/envoice dashboard.png' },
  { category: 'Web Design', image: '/images/gallery/grind_hero.png' },
  { category: 'Web Design', image: '/images/gallery/filmo_hero.png' },
  { category: 'App Design', image: '/images/gallery/mobile_app_exploration.png' },
  { category: 'Product Design', image: '/images/gallery/quickteller_redesign.png' },
  { category: 'Web Design', image: '/images/gallery/evolvee.png' },
  { category: 'Product Design', image: '/images/gallery/productivity_dashboard.png' },
  { category: 'Product Design', image: '/images/gallery/mint_dashboard.png' },
  { category: 'Web Design', image: '/images/gallery/hero_exploration.png' },
  { category: 'Web Design', image: '/images/gallery/accel234.png' },
  { category: 'Web Design', image: '/images/gallery/housing.co_landing_page.png' },
];
---

<BaseLayout title="Gallery — Samuel Nwokolo" description="A gallery of design explorations by Samuel Nwokolo, a product designer focused on usability and delight.">
  <!-- Gallery -->
  <section class="section-border flex flex-col items-center px-[16px] md:px-[40px] lg:px-[80px] py-[32px] md:py-[64px]">
    <div class="flex w-full flex-col gap-[24px] md:gap-[32px]">
      <SectionTitle title="Gallery" />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[32px] md:gap-x-[16px] md:gap-y-[48px]">
        {galleryItems.map((item) => (
          <div data-scroll-reveal><GalleryCard category={item.category} image={item.image} /></div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Experience from '../components/Experience.astro';
import Cta from '../components/Cta.astro';
---

<BaseLayout title="About — Samuel Nwokolo" description="Learn about Samuel Nwokolo, a product designer who works with founders and teams to create conversion-focused designs.">
  <!-- About -->
  <section class="content-divider flex items-center justify-center px-[16px] md:px-[40px] lg:px-[80px] py-[32px] md:py-[64px]">
    <div class="flex flex-col max-w-[700px] w-full items-start gap-[16px]">
      <!-- Section Title (top) -->
      <div data-scroll-reveal>
        <SectionTitle title="About" />
      </div>

      <!-- Content (below) -->
      <div class="flex w-full md:w-[632px] flex-col items-start gap-[16px]" data-scroll-reveal>
        <h1 class="sr-only">About</h1>

        <div class="h-[150px] w-[150px] shrink-0 overflow-hidden">
          <img
            src="/images/about-profile.png"
            alt="Samuel Nwokolo"
            class="h-full w-full object-cover"
          />
        </div>

        <h2 class="w-full text-[20px] font-semibold leading-[28px] tracking-[-1px] text-content-primary">
          I'm a designer who helps teams turn complex ideas into simple, usable products.
        </h2>

        <p class="w-full text-[16px] leading-[24px] text-content-secondary">
          I care about understanding how things work, but even more about making them work better for the people using them. When I'm not working, I'm at the gym or in the pool trying to swim better than last time.
        </p>

        <!-- Email + Social Links -->
        <div class="flex items-center gap-[16px]">
          <a
            href="mailto:nwokoloikem@gmail.com"
            class="link-swipe w-fit text-[16px] leading-[20px] text-content-primary"
          >
            Email me
          </a>
          <a
            href="https://www.linkedin.com/in/samuelnwokolo/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="link-hover text-content-tertiary"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
          </a>
          <a
            href="https://x.com/Nwokolo_Iyk"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="X (Twitter)"
            class="link-hover text-content-tertiary"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path fill="currentColor" d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <Experience />
  <Cta />
</BaseLayout>

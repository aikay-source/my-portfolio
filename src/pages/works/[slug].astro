---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { projects, getProjectBySlug, getRelatedProjects } from '../../data/projects';

const { slug } = Astro.params;
const project = getProjectBySlug(slug!);
if (!project) {
  return Astro.redirect('/works');
}

const relatedProjects = getRelatedProjects(slug!);

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }));
}
---

<BaseLayout title={`${project.title} — Samuel Nwokolo`} description={project.summary.split('\n')[0].slice(0, 160)}>
  <!-- Hero / Summary -->
  <section class="content-divider flex flex-col items-center px-[16px] md:px-[40px] lg:px-[80px] py-[32px] md:py-[64px]">
    <div class="flex w-full max-w-[848px] flex-col items-start gap-[32px] md:gap-[64px]">
      <!-- Back Button -->
      <a href="/works" class="flex items-center justify-center">
        <div class="flex h-[24px] items-center justify-center gap-[8px]">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-content-tertiary">
            <path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="px-[4px] font-mono text-[14px] font-semibold leading-[20px] text-content-tertiary">
            BACK
          </span>
        </div>
      </a>

      <!-- Heading + Summary -->
      <div class="flex w-full flex-col items-start gap-[32px]">
        <!-- Heading -->
        <h1 class="w-full text-[28px] md:text-[40px] font-semibold leading-[36px] md:leading-[48px] tracking-[-2.2px] text-content-primary">
          {project.title}
        </h1>

        <!-- Summary Row -->
        <div class="flex flex-col md:flex-row w-full items-start gap-[16px] md:justify-between">
          <span class="font-mono text-[12px] font-semibold leading-[16px] text-content-tertiary">
            SUMMARY
          </span>

          <div class="flex w-full md:w-[617px] flex-col items-start gap-[24px]">
            <p class="w-full whitespace-pre-line text-[16px] leading-[24px] text-content-secondary">
              {project.summary}
            </p>

            <div class="flex w-full flex-col items-start gap-[16px]">
              <div class="flex flex-col items-start">
                <span class="font-mono text-[12px] font-semibold leading-[16px] text-content-tertiary">
                  CONTRIBUTION
                </span>
                <span class="text-[16px] leading-[24px] text-content-primary">
                  {project.contribution}
                </span>
              </div>

              <div class="flex flex-col items-start">
                <span class="font-mono text-[12px] font-semibold leading-[16px] text-content-tertiary">
                  YEAR
                </span>
                <span class="text-[16px] leading-[24px] text-content-primary">
                  {project.year}
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- See Also -->
  <section class="section-border section-border-top flex flex-col items-center px-[16px] md:px-[40px] lg:px-[80px] py-[32px] md:py-[64px]">
    <div class="flex w-full max-w-[848px] flex-col items-center gap-[32px]">
      <div class="w-full">
        <SectionTitle title="See Also" />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-[16px] gap-y-[32px] md:gap-y-[64px] w-full">
        {relatedProjects.map((proj) => (
          <ProjectCard {...proj} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
